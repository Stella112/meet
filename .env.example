MAKER_IMPROVE_BPS=15
MAX_INVENTORY_LOSS_BPS=150
MAKER_PRIVATE_KEY=           # separate maker wallet
CONVERT_BUFFER_HOURS=12
EARLY_EDGE_BPS=50
NEWS_TTL_MIN=120
PROTOCOL_FEE_BPS=10
BATCH_SECONDS=60

CELO_RPC_URL=https://forno.celo.org
AGENT_PRIVATE_KEY=
TREASURY_ADDRESS=
MEET_SETTLEMENT_ADDRESS=

ATTRIBUTION_TAG=
ERC8004_AGENT_ID=

TEXTILE_API_KEY=             # optional; keyless RFQ uses takerProof
X402_API_KEY=                # P1 only
BUY_ACCOUNT_NAME=buy
PAID_NEWS=false             # true spends $0.005 per news check from the buy wallet, even in dry-run
STREET_TOKEN=               # 16+ random chars; enables entry at /street. Unset = entry off
STREET_MAX_AGE_HOURS=30     # older street rate shows as "no data" on receipts
STREET_RATE_SOURCE=          # catalog service id, or "manual"
